{
  "realm": "cvs",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "cv-read"
      },
      {
        "name": "cv-write"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cvs-reader",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${CVS_READER_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "cvs-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "cvs-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "usermodel.realmRoleMapping.rolePrefix": ""
          }
        }
      ]
    },
    {
      "clientId": "cvs-writer",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${CVS_WRITER_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "cvs-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "cvs-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "usermodel.realmRoleMapping.rolePrefix": ""
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-cvs-reader",
      "enabled": true,
      "serviceAccountClientId": "cvs-reader",
      "realmRoles": [
        "cv-read"
      ]
    },
    {
      "username": "service-account-cvs-writer",
      "enabled": true,
      "serviceAccountClientId": "cvs-writer",
      "realmRoles": [
        "cv-read",
        "cv-write"
      ]
    }
  ]
}
